}

#[test]
fn r10_w1_to_w3_rollback() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws3_parent = tempdir().expect("ws3 parent");
    let ws3_path = ws3_parent.path().join("workspace3");

    let ws3_lease = {
        let mut manager = WorkspaceManager::new(&mut fixture.repository, Redactor::default());
        manager
            .create_local(
                "ws3-rb",
                "project-rb",
                &ws3_path,
                None,
                Some("env-rb"),
                "t-w3",
            )
            .expect("ws3");
        manager
            .acquire_lease("ws3-rb", "agent-cursor", 0, 1_000_000)
            .expect("ws3 lease")
    };

    fixture
        .repository
        .metadata_mut()
        .create_execution(&ExecutionCreation {
            execution_id: "exec-w3".into(),
            task_id: "task-rb".into(),
            agent_id: "agent-cursor".into(),
            parent_execution_id: None,
            created_at: "t-w3".into(),
        })
        .expect("execution");

    let ws3 = fixture
        .repository
        .metadata()
        .workspace("ws3-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-w3".into(),
            execution_id: "exec-w3".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws3.revision),
            lease: Some(ws3_lease),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let ws3_after = fixture
        .repository
        .metadata()
        .workspace("ws3-rb")
        .unwrap()
        .unwrap();
    assert_eq!(ws3_after.head.as_deref(), rollback.result_workspace_head.as_deref());
}

#[test]
fn r10_multiple_targets_independently_rollback_to_same_source() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws3_parent = tempdir().expect("ws3 parent");
    let ws3_path = ws3_parent.path().join("workspace3");

    let ws3_lease = {
        let mut manager = WorkspaceManager::new(&mut fixture.repository, Redactor::default());
        manager
            .create_local(
                "ws3-multi",
                "project-rb",
                &ws3_path,
                None,
                Some("env-rb"),
                "t-w3",
            )
            .expect("ws3");
        manager
            .acquire_lease("ws3-multi", "agent-cursor", 0, 1_000_000)
            .expect("ws3 lease")
    };

    fixture
        .repository
        .metadata_mut()
        .create_execution(&ExecutionCreation {
            execution_id: "exec-w3-multi".into(),
            task_id: "task-rb".into(),
            agent_id: "agent-cursor".into(),
            parent_execution_id: None,
            created_at: "t-w3".into(),
        })
        .expect("execution");

    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();
    let ws3_before = fixture
        .repository
        .metadata()
        .workspace("ws3-multi")
        .unwrap()
        .unwrap();

    let rb_w2 = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-multi-w2".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("w2 rollback");

    let rb_w3 = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-multi-w3".into(),
            execution_id: "exec-w3-multi".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws3_before.revision),
            lease: Some(ws3_lease),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("w3 rollback");

    assert_eq!(
        rb_w2.source_version_id,
        rb_w3.source_version_id
    );
    assert_ne!(
        rb_w2.result_workspace_head,
        rb_w3.result_workspace_head
    );
}

#[test]
fn r10_concurrent_target_rollback_isolation() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-isolation".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let ws1_after = fixture
        .repository
        .metadata()
        .workspace("ws1-rb")
        .unwrap()
        .unwrap();
    let ws2_after = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    assert_ne!(ws1_after.head, ws2_after.head);
    assert_eq!(ws2_after.head.as_deref(), rollback.result_workspace_head.as_deref());
}
