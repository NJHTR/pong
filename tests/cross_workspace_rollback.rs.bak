// R8: Idempotency

#[test]
fn r8_repeated_same_operation() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let first = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-repeat".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("first rollback");

    let ws2_after_first = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let second = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-repeat".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_after_first.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("second rollback");

    assert_eq!(first.rollback_id, second.rollback_id);
    assert_eq!(first.result_workspace_head, second.result_workspace_head);
}

