            rollback_id: "rb-retry".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(rollback.status, "completed");
}

#[test]
fn r8_no_duplicate_corruption() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-no-dup".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let ws2_after_first = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-no-dup".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_after_first.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("retry");

    let ws2_after_second = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    assert_eq!(ws2_after_first.head, ws2_after_second.head);
}

// R9: Recovery

#[test]
fn r9_cold_reopen() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-reopen".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let project_path = fixture._project.path().to_path_buf();
    drop(fixture);

    let reopened = Repository::open(&project_path).expect("reopen");
    let ws2 = reopened.metadata().workspace("ws2-rb").unwrap().unwrap();
    assert_eq!(ws2.head.as_deref(), rollback.result_workspace_head.as_deref());
}

#[test]
fn r9_rollback_record_reload() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-record-reload".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let project_path = fixture._project.path().to_path_buf();
    drop(fixture);

    let reopened = Repository::open(&project_path).expect("reopen");
    let reloaded = reopened
        .metadata()
        .rollback_record(&rollback.rollback_id)
        .unwrap()
        .unwrap();
    assert_eq!(reloaded.rollback_id, rollback.rollback_id);
    assert_eq!(reloaded.status, "completed");
    assert!(reloaded.result_version_id.is_none());
}

#[test]
fn r9_snapshot_reload() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-snap-reload".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let result_head = rollback.result_workspace_head.as_ref().unwrap();
    let snapshot_id = format!("snp-{}", result_head.strip_prefix("sha256:").unwrap());

    let project_path = fixture._project.path().to_path_buf();
    drop(fixture);

    let reopened = Repository::open(&project_path).expect("reopen");
    let snapshot = reopened
        .metadata()
        .snapshot_record(&snapshot_id)
        .unwrap()
        .unwrap();
    assert_eq!(snapshot.workspace_id, "ws2-rb");
}

#[test]
fn r9_cas_reload() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-cas-reload".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    let result_head = rollback.result_workspace_head.as_ref().unwrap();
    let digest_hex = result_head.strip_prefix("sha256:").unwrap();
    let digest = Digest::from_hex(digest_hex).unwrap();

    let project_path = fixture._project.path().to_path_buf();
    drop(fixture);

    let reopened = Repository::open(&project_path).expect("reopen");
    let cas_path = reopened.cas().object_path(digest);
    assert!(cas_path.exists());
}

// R10: Scenarios

#[test]
fn r10_codex_execution_rollback_to_cursor_base() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    // Codex (agent-codex) created V100 in W1
    // Cursor (agent-cursor) executes in W2, now rolls back to V100[W1]
    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-codex-cursor".into(),
            execution_id: fixture.execution_id.clone(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            lease: Some(fixture.ws2_lease.clone()),
            created_at: "t-rb".into(),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(rollback.status, "completed");
    assert_eq!(
        rollback.source_version_id.as_deref(),
        Some(fixture.source_version.version_id.as_str())
    );
}

