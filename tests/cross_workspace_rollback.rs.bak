            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-004".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(rollback.previous_version_head, previous_version_head);
}

// R3: Materialization

#[test]
fn r3_nested_tree() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-nested".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-nested".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    let nested_content = fs::read(fixture.ws2_path.join("source_dir/nested.txt"))
        .expect("nested file");
    assert_eq!(nested_content, b"nested source");
}

#[test]
fn r3_empty_tree() {
    let project = tempdir().expect("project");
    let ws1_parent = tempdir().expect("ws1 parent");
    let ws2_parent = tempdir().expect("ws2 parent");
    let mut repository = Repository::init(project.path()).expect("repository");

    repository
        .metadata_mut()
        .record_environment(
            "env-empty",
            "project-empty",
            &json!({"schema_version": 1}),
            "t0",
        )
        .expect("environment");

    for (id, provider) in [("agent-a", "a"), ("agent-b", "b")] {
        repository
            .metadata_mut()
            .create_agent_identity(&AgentIdentity {
                agent_id: id.into(),
                provider: provider.into(),
                display_name: None,
                created_at: "t0".into(),
            })
            .expect("agent");
    }

    repository
        .metadata_mut()
        .create_task(&TaskCreation {
            task_id: "task-empty".into(),
            project_id: "project-empty".into(),
            goal: "empty rollback".into(),
            context_ref: None,
            created_at: "t0".into(),
        })
        .expect("task");

    repository
        .metadata_mut()
        .create_execution(&ExecutionCreation {
            execution_id: "exec-empty".into(),
            task_id: "task-empty".into(),
            agent_id: "agent-b".into(),
            parent_execution_id: None,
            workspace_id: Some("ws2-empty".into()),
            base_version_id: None,
            current_version_id: None,
            created_at: "t0".into(),
        })
        .expect("execution");

    let ws1_path = ws1_parent.path().join("ws1");
    let ws1_lease = {
        let mut manager = WorkspaceManager::new(&mut repository, Redactor::default());
        manager
            .create_local(
                "ws1-empty",
                "project-empty",
                &ws1_path,
                None,
                Some("env-empty"),
                "t0",
            )
            .expect("ws1");
        manager
            .acquire_lease("ws1-empty", "agent-a", 0, 1_000_000)
            .expect("lease")
    };

    let snapshot = WorkspaceManager::new(&mut repository, Redactor::default())
        .snapshot_local(
            "ws1-empty",
            &ws1_lease,
            SnapshotOptions::default(),
            1,
            "t1",
        )
        .expect("snapshot");

    let operation = OperationEnvelope {
        operation_id: "op-empty".into(),
        project_id: "project-empty".into(),
        request_id: "req-empty".into(),
        agent_id: "agent-a".into(),
        session_id: "session".into(),
        workspace_id: Some("ws1-empty".into()),
        environment_id: Some("env-empty".into()),
        parent_operation_id: None,
        schema_version: "0.1".into(),
        started_at: "t1".into(),
        tool: "test".into(),
        action: "version.create".into(),
        input_refs: vec![OperationRef {
            kind: "snapshot".into(),
            reference: snapshot.snapshot_id.clone(),
            media_type: None,
        }],
        output_refs: Vec::new(),
        resource: None,
        before_state: None,
        after_state: None,
        reversibility: "REVERSIBLE".into(),
        replayability: "REPLAYABLE".into(),
        side_effect: "WORKSPACE".into(),
        policy_decision: None,
    };
    repository
        .metadata_mut()
        .start_operation(operation)
        .expect("operation");

    let version = repository
        .metadata_mut()
        .create_version(VersionPublication {
            workspace_id: "ws1-empty".into(),
            project_id: "project-empty".into(),
            snapshot_id: snapshot.snapshot_id,
            creation_operation_id: "op-empty".into(),
            environment_id: Some("env-empty".into()),
            created_at: "t1".into(),
            parent_version_id: None,
        })
        .expect("version");

    let ws2_path = ws2_parent.path().join("ws2");
    let ws2_lease = {
        let mut manager = WorkspaceManager::new(&mut repository, Redactor::default());
        manager
            .create_local(
                "ws2-empty",
                "project-empty",
                &ws2_path,
                None,
                Some("env-empty"),
                "t2",
            )
            .expect("ws2");
        manager
            .acquire_lease("ws2-empty", "agent-b", 0, 1_000_000)
            .expect("lease")
    };

    fs::write(ws2_path.join("before.txt"), b"before").expect("before");

    let ws2 = repository
        .metadata()
        .workspace("ws2-empty")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-empty".into(),
            task_id: "task-empty".into(),
            execution_id: "exec-empty".into(),
            workspace_id: "ws2-empty".into(),
            target: RollbackTarget::Version(version.version_id),
            actor_agent_id: "agent-b".into(),
            request_id: "req-rb-empty".into(),
            created_at: "t-rb".into(),
            lease: Some(ws2_lease),
            expected_workspace_revision: Some(ws2.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    let entries: Vec<_> = fs::read_dir(&ws2_path).unwrap().collect();
    assert_eq!(entries.len(), 0);
}

#[test]
fn r3_multiple_blobs() {
    let mut fixture = setup_cross_workspace_rollback_fixture();

    // Add more files to W1
    for i in 0..5 {
        fs::write(
            fixture.ws1_path.join(format!("file{}.txt", i)),
            format!("content {}", i).as_bytes(),
        )
        .expect("file");
    }

    let snapshot = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .snapshot_local(
            "ws1-rb",
            &fixture.ws1_lease,
            SnapshotOptions::default(),
            2,
            "t-multi",
        )
        .expect("snapshot");

    let operation = OperationEnvelope {
        operation_id: "op-multi".into(),
        project_id: "project-rb".into(),
        request_id: "req-multi".into(),
        agent_id: "agent-codex".into(),
        session_id: "session".into(),
        workspace_id: Some("ws1-rb".into()),
        environment_id: Some("env-rb".into()),
        parent_operation_id: None,
        schema_version: "0.1".into(),
        started_at: "t-multi".into(),
        tool: "test".into(),
        action: "version.create".into(),
        input_refs: vec![
            OperationRef {
                kind: "version".into(),
                reference: fixture.source_version.version_id.clone(),
                media_type: None,
            },
            OperationRef {
                kind: "snapshot".into(),
                reference: snapshot.snapshot_id.clone(),
                media_type: None,
            },
        ],
        output_refs: Vec::new(),
        resource: None,
        before_state: None,
        after_state: None,
        reversibility: "REVERSIBLE".into(),
        replayability: "REPLAYABLE".into(),
        side_effect: "WORKSPACE".into(),
        policy_decision: None,
    };
    fixture
        .repository
        .metadata_mut()
        .start_operation(operation)
        .expect("operation");

    let multi_version = fixture
        .repository
        .metadata_mut()
        .create_version(VersionPublication {
            workspace_id: "ws1-rb".into(),
            project_id: "project-rb".into(),
            snapshot_id: snapshot.snapshot_id,
            creation_operation_id: "op-multi".into(),
            environment_id: Some("env-rb".into()),
            created_at: "t-multi".into(),
            parent_version_id: Some(fixture.source_version.version_id.clone()),
        })
        .expect("version");

    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-multi".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(multi_version.version_id),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-multi".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    for i in 0..5 {
        let content = fs::read(fixture.ws2_path.join(format!("file{}.txt", i)))
            .expect("file");
        assert_eq!(content, format!("content {}", i).as_bytes());
    }
}

#[test]
fn r3_shared_cas() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-cas".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-cas".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    // Verify source CAS still exists
    let source_snapshot = fixture
        .repository
        .metadata()
        .snapshot_record(&fixture.source_version.snapshot_id)
        .unwrap()
        .unwrap();
    let source_digest = source_snapshot.root_digest.strip_prefix("sha256:").unwrap();
    let digest = Digest::from_hex(source_digest).unwrap();
    let cas_path = fixture.repository.cas().object_path(digest);
    assert!(cas_path.exists());
}

