//! M3-SLICE-003G-RE / PHASE-3: Cross-Workspace Rollback
//!
//! This phase validates cross-workspace rollback: target workspace W2 rolls back
//! to source Version V100[W1]. The rollback materializes source content into
//! target workspace, creates target-local Snapshot, updates W2.head, preserves
//! W2.version_head_id, and records RollbackRecord with result_version_id = NULL.

use pong_core::cas::Digest;
use pong_core::metadata::{
    AgentIdentity, ExecutionCreation, OperationEnvelope, OperationRef, RollbackCreation,
    RollbackTarget, TaskCreation, VersionPublication,
};
use pong_core::redaction::Redactor;
use pong_core::workspace::{SnapshotOptions, WorkspaceManager};
use pong_core::{LeaseToken, PongError, Repository, VersionRecord};
use serde_json::json;
use std::fs;
use std::path::PathBuf;
use tempfile::tempdir;

struct CrossWorkspaceRollbackFixture {
    _project: tempfile::TempDir,
    _ws1_parent: tempfile::TempDir,
    _ws2_parent: tempfile::TempDir,
    repository: Repository,
    ws1_path: PathBuf,
    ws2_path: PathBuf,
    ws1_lease: LeaseToken,
    ws2_lease: LeaseToken,
    source_version: VersionRecord,
    execution_id: String,
}

fn setup_cross_workspace_rollback_fixture() -> CrossWorkspaceRollbackFixture {
    let project = tempdir().expect("project");
    let ws1_parent = tempdir().expect("ws1 parent");
    let ws2_parent = tempdir().expect("ws2 parent");
    let mut repository = Repository::init(project.path()).expect("repository");

    // Create shared environment
    repository
        .metadata_mut()
        .record_environment(
            "env-rb",
            "project-rb",
            &json!({"schema_version": 1, "os": "windows"}),
            "t0",
        )
        .expect("environment");

    // Create agents
    for (id, provider) in [("agent-codex", "codex"), ("agent-cursor", "cursor")] {
        repository
            .metadata_mut()
            .create_agent_identity(&AgentIdentity {
                agent_id: id.into(),
                provider: provider.into(),
                display_name: None,
                created_at: "t0".into(),
            })
            .expect("agent");
    }

    // Create task
    repository
        .metadata_mut()
        .create_task(&TaskCreation {
            task_id: "task-rb".into(),
            project_id: "project-rb".into(),
            goal: "cross-workspace rollback".into(),
            context_ref: None,
            created_at: "t0".into(),
        })
        .expect("task");

    // Create execution
    let execution_id = "exec-rb-001".to_string();
    repository
        .metadata_mut()
        .create_execution(&ExecutionCreation {
            execution_id: execution_id.clone(),
            task_id: "task-rb".into(),
            agent_id: "agent-cursor".into(),
            parent_execution_id: None,
            workspace_id: Some("ws2-rb".into()),
            base_version_id: None,
            current_version_id: None,
            created_at: "t0".into(),
        })
        .expect("execution");

    // Create W1
    let ws1_path = ws1_parent.path().join("workspace1");
    let ws1_lease = {
        let mut manager = WorkspaceManager::new(&mut repository, Redactor::default());
        manager
            .create_local(
                "ws1-rb",
                "project-rb",
                &ws1_path,
                None,
                Some("env-rb"),
                "t0",
            )
            .expect("ws1");
        manager
            .acquire_lease("ws1-rb", "agent-codex", 0, 1_000_000)
            .expect("ws1 lease")
    };

    // Create W2
    let ws2_path = ws2_parent.path().join("workspace2");
    let ws2_lease = {
        let mut manager = WorkspaceManager::new(&mut repository, Redactor::default());
        manager
            .create_local(
                "ws2-rb",
                "project-rb",
                &ws2_path,
                None,
                Some("env-rb"),
                "t1",
            )
            .expect("ws2");
        manager
            .acquire_lease("ws2-rb", "agent-cursor", 0, 1_000_000)
            .expect("ws2 lease")
    };

    // Create source content in W1
    fs::write(ws1_path.join("source.txt"), b"source content").expect("source file");
    fs::create_dir(ws1_path.join("source_dir")).expect("source dir");
    fs::write(ws1_path.join("source_dir/nested.txt"), b"nested source")
        .expect("nested source");

    // Snapshot W1
    let snapshot = WorkspaceManager::new(&mut repository, Redactor::default())
        .snapshot_local("ws1-rb", &ws1_lease, SnapshotOptions::default(), 1, "t2")
        .expect("snapshot");

    // Publish Version V100 in W1
    let operation = OperationEnvelope {
        operation_id: "op-v100-rb".into(),
        project_id: "project-rb".into(),
        request_id: "req-v100-rb".into(),
        agent_id: "agent-codex".into(),
        session_id: "session".into(),
        workspace_id: Some("ws1-rb".into()),
        environment_id: Some("env-rb".into()),
        parent_operation_id: None,
        schema_version: "0.1".into(),
        started_at: "t3".into(),
        tool: "test".into(),
        action: "version.create".into(),
        input_refs: vec![OperationRef {
            kind: "snapshot".into(),
            reference: snapshot.snapshot_id.clone(),
            media_type: None,
        }],
        output_refs: Vec::new(),
        resource: None,
        before_state: None,
        after_state: None,
        reversibility: "REVERSIBLE".into(),
        replayability: "REPLAYABLE".into(),
        side_effect: "WORKSPACE".into(),
        policy_decision: None,
    };
    repository
        .metadata_mut()
        .start_operation(operation)
        .expect("operation");

    let source_version = repository
        .metadata_mut()
        .create_version(VersionPublication {
            workspace_id: "ws1-rb".into(),
            project_id: "project-rb".into(),
            snapshot_id: snapshot.snapshot_id,
            creation_operation_id: "op-v100-rb".into(),
            environment_id: Some("env-rb".into()),
            created_at: "t3".into(),
            parent_version_id: None,
        })
        .expect("version");

    // Create different content in W2
    fs::write(ws2_path.join("target.txt"), b"target content").expect("target file");

    // Snapshot W2
    let ws2_snapshot = WorkspaceManager::new(&mut repository, Redactor::default())
        .snapshot_local("ws2-rb", &ws2_lease, SnapshotOptions::default(), 2, "t4")
        .expect("ws2 snapshot");

    // Publish Version V200 in W2
    let ws2_operation = OperationEnvelope {
        operation_id: "op-v200-rb".into(),
        project_id: "project-rb".into(),
        request_id: "req-v200-rb".into(),
        agent_id: "agent-cursor".into(),
        session_id: "session".into(),
        workspace_id: Some("ws2-rb".into()),
        environment_id: Some("env-rb".into()),
        parent_operation_id: None,
        schema_version: "0.1".into(),
        started_at: "t4".into(),
        tool: "test".into(),
        action: "version.create".into(),
        input_refs: vec![OperationRef {
            kind: "snapshot".into(),
            reference: ws2_snapshot.snapshot_id.clone(),
            media_type: None,
        }],
        output_refs: Vec::new(),
        resource: None,
        before_state: None,
        after_state: None,
        reversibility: "REVERSIBLE".into(),
        replayability: "REPLAYABLE".into(),
        side_effect: "WORKSPACE".into(),
        policy_decision: None,
    };
    repository
        .metadata_mut()
        .start_operation(ws2_operation)
        .expect("ws2 operation");

    let ws2_version = repository
        .metadata_mut()
        .create_version(VersionPublication {
            workspace_id: "ws2-rb".into(),
            project_id: "project-rb".into(),
            snapshot_id: ws2_snapshot.snapshot_id,
            creation_operation_id: "op-v200-rb".into(),
            environment_id: Some("env-rb".into()),
            created_at: "t4".into(),
            parent_version_id: None,
        })
        .expect("ws2 version");

    // Update W2 version head to V200 via version creation
    // (version_head_id is automatically updated when creating a version in the same workspace)

    CrossWorkspaceRollbackFixture {
        _project: project,
        _ws1_parent: ws1_parent,
        _ws2_parent: ws2_parent,
        repository,
        ws1_path,
        ws2_path,
        ws1_lease,
        ws2_lease,
        source_version,
        execution_id,
    }
}

// R1: Source Validation

#[test]
fn r1_foreign_version_exists() {
    let fixture = setup_cross_workspace_rollback_fixture();
    let version = fixture
        .repository
        .metadata()
        .version_record(&fixture.source_version.version_id)
        .unwrap()
        .unwrap();
    assert_eq!(version.workspace_id, "ws1-rb");
}

#[test]
fn r1_foreign_snapshot_exists() {
    let fixture = setup_cross_workspace_rollback_fixture();
    let snapshot = fixture
        .repository
        .metadata()
        .snapshot_record(&fixture.source_version.snapshot_id)
        .unwrap()
        .unwrap();
    assert_eq!(snapshot.workspace_id, "ws1-rb");
    assert!(!snapshot.root_digest.is_empty());
}

#[test]
fn r1_version_snapshot_consistency() {
    let fixture = setup_cross_workspace_rollback_fixture();
    let version = fixture
        .repository
        .metadata()
        .version_record(&fixture.source_version.version_id)
        .unwrap()
        .unwrap();
    let snapshot = fixture
        .repository
        .metadata()
        .snapshot_record(&version.snapshot_id)
        .unwrap()
        .unwrap();
    assert_eq!(version.snapshot_id, snapshot.snapshot_id);
    assert_eq!(version.workspace_id, snapshot.workspace_id);
}

#[test]
fn r1_source_ownership() {
    let fixture = setup_cross_workspace_rollback_fixture();
    let version = fixture
        .repository
        .metadata()
        .version_record(&fixture.source_version.version_id)
        .unwrap()
        .unwrap();
    assert_eq!(version.workspace_id, "ws1-rb");
    assert_eq!(version.project_id, "project-rb");
}

#[test]
fn r1_scope_compatibility() {
    let fixture = setup_cross_workspace_rollback_fixture();
    let ws2 = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();
    // Verify scope compatibility via project_id and environment_id
    let version = fixture
        .repository
        .metadata()
        .version_record(&fixture.source_version.version_id)
        .unwrap()
        .unwrap();
    assert_eq!(version.project_id, ws2.project_id);
    assert_eq!(version.environment_id, ws2.environment_id);
}

// R2: Rollback Preparation

#[test]
fn r2_prepared_record_created() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-001".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-001".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(rollback.status, "completed");
}

#[test]
fn r2_source_ids_recorded() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-002".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-002".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(
        rollback.source_version_id.as_deref(),
        Some(fixture.source_version.version_id.as_str())
    );
    assert_eq!(
        rollback.source_snapshot_id.as_deref(),
        Some(fixture.source_version.snapshot_id.as_str())
    );
}

#[test]
fn r2_previous_workspace_head_recorded() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();
    let previous_head = ws2_before.head.clone();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-003".into(),
            task_id: "task-rb".into(),
            execution_id: fixture.execution_id.clone(),
            workspace_id: "ws2-rb".into(),
            target: RollbackTarget::Version(fixture.source_version.version_id.clone()),
            actor_agent_id: "agent-cursor".into(),
            request_id: "req-rb-003".into(),
            created_at: "t-rb".into(),
            lease: Some(fixture.ws2_lease.clone()),
            expected_workspace_revision: Some(ws2_before.revision),
            now_ms: Some(100),
        })
        .expect("rollback");

    assert_eq!(rollback.previous_workspace_head, previous_head);
}

#[test]
fn r2_previous_version_head_recorded() {
    let mut fixture = setup_cross_workspace_rollback_fixture();
    let ws2_before = fixture
        .repository
        .metadata()
        .workspace("ws2-rb")
        .unwrap()
        .unwrap();
    let previous_version_head = ws2_before.version_head_id.clone();

    let rollback = WorkspaceManager::new(&mut fixture.repository, Redactor::default())
        .rollback_local(&RollbackCreation {
            rollback_id: "rb-004".into(),
